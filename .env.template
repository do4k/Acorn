# Compose environment started by a bare `docker compose up`.
# One of: mysql | sqlite | postgres | sqlserver
# Each profile brings up its database, the game server, the REST API and the
# Aspire dashboard together. Override per run with e.g.
# `docker compose --profile postgres up`.
COMPOSE_PROFILES=mysql

# Cache Configuration (shared by the server and the API)
CACHE_ENABLED=true

# MySQL Configuration (used by the mysql profile)
MYSQL_DATABASE=acorn
MYSQL_USER=acorn
MYSQL_PASSWORD=acornpassword
MYSQL_ROOT_PASSWORD=rootpassword

# API Configuration
ASPNETCORE_ENVIRONMENT=Production

# Server Configuration
SERVER_SLN_ENABLED=true

# Web (Caddy) - path to the built eoweb static client served at game.acornhost.io.
# Defaults to the bundled placeholder; point it at a real build to deploy the client.
EOWEB_DIST=./deploy/eoweb
