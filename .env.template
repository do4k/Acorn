# Compose profiles started by `docker compose up`: your database profile plus
# "true". The "true" profile gates the aspire-dashboard service, whose profile
# name mirrors ASPIRE_ENABLED. Remove "true" (and set ASPIRE_ENABLED=false) to
# stop starting the dashboard container.
COMPOSE_PROFILES=mysql,true

# Cache Configuration (shared by the server and the API)
CACHE_ENABLED=true

# MySQL Configuration (used by the mysql profile)
MYSQL_DATABASE=acorn
MYSQL_USER=acorn
MYSQL_PASSWORD=acornpassword
MYSQL_ROOT_PASSWORD=rootpassword

# API Configuration
ASPNETCORE_ENVIRONMENT=Production

# Server Configuration
SERVER_SLN_ENABLED=true

# Web (Caddy) - path to the built eoweb static client served at game.<BASE_DOMAIN>.
# Defaults to the bundled placeholder; point it at a real build to deploy the client.
EOWEB_DIST=./deploy/eoweb

# Base domain for every Caddy site. Sites are <BASE_DOMAIN> (landing page),
# game.<BASE_DOMAIN> (eoweb + WebSocket) and aspire.<BASE_DOMAIN> (dashboard).
BASE_DOMAIN=acornhost.io

# Aspire dashboard (aspire.<BASE_DOMAIN>). Set to false to stop serving it and
# to stop starting the aspire-dashboard container.
ASPIRE_ENABLED=true

# Aspire basic-auth. Required while ASPIRE_ENABLED=true.
# Generate a hash with:
#   docker run --rm caddy:2 caddy hash-password --plaintext 'your-password'
# bcrypt hashes contain '$' - escape each one as '$$' in this file.
ASPIRE_USER=acorn
ASPIRE_PASSWORD_HASH=

# Acornbot (PM self-service bot). The same values are applied to the game
# server and the API so the online-players list only advertises the bot when
# the server actually answers whispers to it.
ACORNBOT_ENABLED=true
ACORNBOT_NAME=Acornbot
