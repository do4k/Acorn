# Caddy configuration for the Acorn deployment.
#
#   <BASE_DOMAIN>          -> static landing page + /gamedata (game data)
#   game.<BASE_DOMAIN>     -> eoweb static client + WebSocket bridge to Acorn
#   api.<BASE_DOMAIN>      -> read-only REST API (game state queries)
#   aspire.<BASE_DOMAIN>   -> Aspire dashboard (only when ASPIRE_ENABLED=true)
#
# All site addresses come from BASE_DOMAIN (see .env). TLS certificates are
# obtained and renewed automatically (Let's Encrypt); every hostname must
# resolve to this host and ports 80/443 must be reachable.
#
# The Aspire site lives in aspire.caddy and is appended by entrypoint.sh.

{
	# Set an email to receive expiry notices from Let's Encrypt (optional).
	# email admin@{$BASE_DOMAIN}

	# Uncomment to test with the staging CA and avoid rate limits:
	# acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
}

# Landing page + game data for scripts/fetch-game-data.sh.
#
# The /gamedata path serves the copyright-protected game files (dat*.edf,
# maps/*.emf, ...) that are deliberately not in git, so clean checkouts can
# fetch them before building (issue #144). No directory listing; the raw tree
# lives under /gamedata/files/, the tarball + checksum at the top level.
{$BASE_DOMAIN} {
	handle_path /gamedata/* {
		root * /srv/gamedata
		file_server
	}

	handle {
		root * /srv/landing
		file_server
	}
}

# eoweb browser client + WebSocket endpoint (wss://game.<BASE_DOMAIN>)
game.{$BASE_DOMAIN} {
	# Any request that is a WebSocket upgrade (any path, including "/")
	# is forwarded to the Acorn WebSocket listener.
	@ws {
		header Connection *Upgrade*
		header Upgrade websocket
	}
	reverse_proxy @ws acorn-server:8079

	# Everything else is the static eoweb build.
	root * /srv/eoweb
	try_files {path} /index.html
	file_server
}

# Read-only REST API (health, characters, maps, online players, pub data).
api.{$BASE_DOMAIN} {
	reverse_proxy acorn-api:8080
}
