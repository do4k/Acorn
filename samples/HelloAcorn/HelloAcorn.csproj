<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <!-- Produce a .deps.json on build and copy private dependencies, so the
             published folder can be loaded as a plugin. -->
        <EnableDynamicLoading>true</EnableDynamicLoading>
    </PropertyGroup>

    <ItemGroup>
        <!-- Contracts are provided by the server at runtime: never copy them into
             the plugin output, or type identity across the load-context boundary
             breaks (InvalidCastException on IAcornPlugin). -->
        <ProjectReference Include="..\..\src\Acorn.Plugins\Acorn.Plugins.csproj">
            <Private>false</Private>
            <ExcludeAssets>runtime</ExcludeAssets>
        </ProjectReference>
    </ItemGroup>

    <ItemGroup>
        <None Update="plugin.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

</Project>
